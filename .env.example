# Placeholders only. Never commit real values. Copy to .env.
# --- HTML scraper (htmlscraper) ---
SCRAPER_TIMEOUT=15
SCRAPER_DELAY=2
# Optional proxy (Mohamed). Leave empty for a direct connection. Format: http://user:password@host:port
SCRAPER_HTTP_PROXY=
SCRAPER_HTTPS_PROXY=
# Optional pool, comma separated (used with --failover)
SCRAPER_PROXY_LIST=
# --- Best Buy API client (bestbuy_scraper, optional, never run live) ---
BESTBUY_API_KEY=YOUR_BESTBUY_API_KEY_HERE
